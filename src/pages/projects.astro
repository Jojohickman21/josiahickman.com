---
import Layout from '@/layouts/Layout.astro';
import DitherBackground from '@/components/DitherBackground';
---

<Layout title="Projects - Josiah Hickman" showDither={false}>
  <div class="projects-page">
    <!-- Intro Section with localized Dither -->
    <section class="hero-section">
      <div class="dither-container">
        <DitherBackground client:only="react" className="absolute inset-0 z-0 pointer-events-none" src="/droids_header.jpg" gridSize={2} colorMode="original" />
      </div>
    </section>

    <div class="content-section">
      <div class="header-block">
        <h1>Projects and Adventures</h1>
        <p class="subtitle">Here's some of the stuff I've been up to.</p>
      </div>

      <div class="projects-grid">
        <!-- Project 1 -->
        <a href="/projects/example" class="project-card">
          <div class="project-image">
            <div class="image-placeholder">
              <span>Project Image</span>
            </div>
          </div>
          <div class="project-info">
            <h2>onethreenine.net</h2>
            <p>A web accessable corkboard for my apartment.</p>
          </div>
        </a>

        <!-- Project 2 -->
        <a href="/projects/example" class="project-card">
          <div class="project-image">
            <div class="image-placeholder">
              <span>Project Image</span>
            </div>
          </div>
          <div class="project-info">
            <h2>Quote Receipts</h2>
            <p>"Did I really say that?" Why yes, you did.</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .projects-page {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-dark);
  }

  .hero-section {
    position: relative;
    width: 100%;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
    height: 50vh;
    min-height: 400px;
  }

  .dither-container {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .content-section {
    max-width: 64rem;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    width: 100%;
  }

  .header-block {
    margin-bottom: 4rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }

  .project-card {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    align-items: flex-start;
    transition: transform 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
  }

  .project-image {
    width: 200px;
    height: 140px;
    border-radius: 1.5rem;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--border-subtle);
    transition: transform 0.2s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.02);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-placeholder span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
  }

  .project-info h2 {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
  }

  .project-card:hover .project-info h2 {
    color: var(--accent);
  }

  .project-info p {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .project-card {
      flex-direction: column;
    }

    .project-image {
      width: 100%;
      height: 180px;
    }
  }
</style>