---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Viewing College life as a K-armed bandit problem - Josiah Hickman" showDither={false}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">

  <div class="article-page">
    <article class="max-w-3xl mx-auto px-6 pl-12 md:pl-24">
      
      <!-- Header -->
      <header class="mb-12">
        <h1>
          Viewing College life as a K-armed bandit problem
        </h1>
        <div class="meta">
          <time datetime="2025-12-25">Dec 2025</time>
          <span>•</span>
          <span>12–15 mins</span>
        </div>
      </header>

      <hr />

      <!-- Text Content -->
      <div class="content">
        <p>
          Viewing college life as a K-armed bandit problem.
        </p>
        <p class="placeholder">
           (Enter your text here...)
        </p>
      </div>

    </article>
  </div>
</Layout>

<style>
  .article-page {
    width: 100%;
    min-height: 100vh;
    padding-top: 8rem;
    padding-bottom: 5rem;
    background: var(--bg-dark);
  }

  h1 {
    font-family: 'Crimson Pro', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-style: italic;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  hr {
    border-color: var(--border-subtle);
    margin-bottom: 3rem;
  }

  .content {
    font-family: 'Crimson Pro', serif;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .content p {
    margin-bottom: 1.5rem;
  }

  .placeholder {
    font-style: italic;
    color: var(--text-muted);
  }
</style>
