---
import Layout from '@/layouts/Layout.astro';
import DitherBackground from '@/components/DitherBackground';
---

<Layout title="Thoughts - Josiah Hickman" showDither={false}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">

  <div class="thoughts-page">
    <!-- Intro Section with localized Dither -->
    <section class="hero-section">
      <div class="dither-container">
        <DitherBackground client:only="react" className="absolute inset-0 z-0 pointer-events-none" src="/Death_star_header.jpg" gridSize={2} colorMode="original" />
      </div>
    </section>

    <!-- Writing List Section -->
    <div class="content-section">
      <div class="header-block">
        <h2>Thoughts & Essays</h2>
        <h3>
          You don't really know anything<br class="hidden md:block" />
          until you've tried to write about it.
        </h3>
      </div>

      <section class="writings-list">
        <!-- Item 1 -->
        <div class="writparent group">
          <a href="/thoughts/example" class="block hover:no-underline">
            <div class="flex justify-between items-baseline mb-2">
              <p class="writing-title">Viewing College life as a K-armed bandit problem</p>
              <p class="writing-date">Dec 2025</p>
            </div>
            <div class="flex justify-between items-start">
              <p class="writing-desc">Applying the K-armed bandit framework to life decisions as a College student.</p>
            </div>
          </a>
        </div>
        <hr />

        <!-- Item 2 -->
        <div class="writparent group">
          <a href="#" class="block hover:no-underline">
            <div class="flex justify-between items-baseline mb-2">
              <p class="writing-title">How to create as a neurotic introvert</p>
              <p class="writing-date">Dec 2025</p>
            </div>
            <div class="flex justify-between items-start">
              <p class="writing-desc">Some thoughts on how to build the future largely outside your comfort zone.</p>
            </div>
          </a>
        </div>
        <hr />
      </section>

      <!-- Simple Footer -->
      <footer class="page-footer">
        <div class="footer-content">
          <div class="footer-links">
            <a href="https://github.com/Jojohickman21">
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.841 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
            </a>
            <a href="mailto:jhickman@usc.edu">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </a>
          </div>
          <p class="copyright">Copyright © 2025 Josiah Hickman</p>
        </div>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .thoughts-page {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-dark);
  }

  .hero-section {
    position: relative;
    width: 100%;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
    height: 50vh;
    min-height: 400px;
  }

  .dither-container {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .content-section {
    max-width: 42rem;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    width: 100%;
  }

  .header-block {
    margin-bottom: 4rem;
  }

  h2 {
    font-family: 'Crimson Pro', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 36rem;
  }

  .writings-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  hr {
    border-color: var(--border-subtle);
  }

  .writing-title {
    font-family: 'Crimson Pro', serif;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .writparent:hover .writing-title {
    color: var(--accent);
  }

  .writing-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .writing-desc {
    font-family: 'Crimson Pro', serif;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 36rem;
  }

  /* Animation */
  .writparent {
    opacity: 0;
    transform: translateY(10px);
    animation: fadeInUp 0.5s ease forwards;
  }

  .writparent:nth-child(1) { animation-delay: 0.1s; }
  .writparent:nth-child(3) { animation-delay: 0.2s; }
  .writparent:nth-child(5) { animation-delay: 0.3s; }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Footer */
  .page-footer {
    margin-top: 8rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .copyright {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>