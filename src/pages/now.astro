---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Now - Josiah Hickman" showDither={false}>
  <div class="now-page">
    <div class="container">
      <h1>Now</h1>
      <p>Check out what I'm working on.</p>
    </div>
  </div>
</Layout>

<style>
  .now-page {
    min-height: 100vh;
    background: var(--bg-dark);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  h1 {
    color: var(--accent);
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
</style>